# Puerto de la API
PORT=4000

# OBLIGATORIO en producción: firma los tokens de sesión.
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión (formato de la librería jsonwebtoken)
TOKEN_TTL=30d

# Dominios autorizados a consumir la API, separados por coma.
# Dejar vacío permite cualquier origen (solo para desarrollo).
CORS_ORIGIN=

# Carpeta donde se guarda la base SQLite (por defecto ./data)
DATA_DIR=

# Zona horaria usada para fechar cuotas y pagos
TZ_NAME=America/Argentina/Buenos_Aires

# Contraseñas del gimnasio de demostración que crea `npm run seed`
DEMO_PASSWORD=demo1234
DEMO_ADMIN_PASSWORD=admin1234

# Respaldos automáticos
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24
# BACKUP_DISABLED=1
